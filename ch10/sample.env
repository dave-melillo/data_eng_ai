# Chapter 10 - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# OpenAI API Key (used in later chapters, good to set up now)
OPENAI_API_KEY=your_openai_api_key_here

# Model configuration
# override as models evolve
DEAI_MODEL_MAIN=gpt-5.5
DEAI_MODEL_MINI=gpt-5.4-mini
OPENAI_TEMPERATURE=0.0
